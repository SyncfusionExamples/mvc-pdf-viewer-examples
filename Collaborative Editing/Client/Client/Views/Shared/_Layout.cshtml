<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @*Collaborative Adapter file*@
    <script src="~/Scripts/pdfViewerAdapter.js"></script>
    <!-- Syncfusion EJ2 base styles and Fluent theme -->
    <link href="~/Scripts/tailwind3.css" rel="stylesheet" />
    <!-- Syncfusion EJ2 base scripts (includes the PDF Viewer module) -->
    <script src="~/Scripts/ej2.min.js"></script>
</head>
<body>
    <div class="container body-content">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    @Html.EJS().ScriptManager()
</body>
</html>
