@using Syncfusion.EJ2
@{
    ViewBag.Title = "Callout Annotation";
}

<div>
    <div class="control-section" style="margin-bottom: 8px;">
        <button type="button" onclick="enableCalloutMode()">Enable Callout Mode</button>
        <button type="button" onclick="exitCalloutMode()">Exit Callout Mode</button>
        <button type="button" onclick="addCalloutProgrammatically()">Add Callout Programmatically</button>
        <button type="button" onclick="editCalloutProgrammatically()">Edit Callout Programmatically</button>
    </div>

    <div style="height: 640px; width: 100%;">
        <!-- DocumentPath specifies the PDF document to load -->
        @Html.EJS().PdfViewer("pdfviewer").DocumentPath("https://cdn.syncfusion.com/content/pdf/pdf-succinctly.pdf").Render()
    </div>
</div>

<style>
    #pdfviewer {
        display: block;
    }
</style>

<script type="text/javascript">
    // Get the PDF Viewer instance
    function getPdfViewerInstance() {
        return document.getElementById('pdfviewer').ej2_instances[0];
    }

    // Enable Callout Annotation mode
    function enableCalloutMode() {
        var viewer = getPdfViewerInstance();
        viewer.annotation.setAnnotationMode('Callout');
    }

    // Exit Callout Annotation mode
    function exitCalloutMode() {
        var viewer = getPdfViewerInstance();
        viewer.annotation.setAnnotationMode('None');
    }

    // Add Callout Annotation programmatically
    function addCalloutProgrammatically() {
        var viewer = getPdfViewerInstance();
        viewer.annotation.addAnnotation('Callout', {
            offset: { x: 200, y: 200 },
            pageNumber: 1,
            opacity: 1,
            borderColor: '#000000',
            borderWidth: 1,
            borderStyle: 'solid',
            author: 'Guest',
            calloutLines: [
                { x: 50, y: 50 },
                { x: 100, y: 100 },
                { x: 200, y: 250 }
            ],
            lineEndingStyle: 'Open'
        });
    }

    // Edit Callout Annotation programmatically
    function editCalloutProgrammatically() {
        var viewer = getPdfViewerInstance();
        if (viewer.annotationCollection) {
            for (var i = 0; i < viewer.annotationCollection.length; i++) {
                var annotation = viewer.annotationCollection[i];
                if (annotation.subject == 'Callout') {
                    annotation.bounds = { x: 300, y: 300, width: 200, height: 40, top: 300, left: 300 };
                    annotation.dynamicText = 'Callout edited';
                    annotation.author = 'Syncfusion';
                    annotation.strokeColor = 'red';
                    annotation.fillColor = 'yellow';
                    annotation.textAlign = 'Center';
                    viewer.annotation.editAnnotation(annotation);
                    break;
                }
            }
        }
    }
</script>