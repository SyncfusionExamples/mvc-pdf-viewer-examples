@using Syncfusion.EJ2
@{
    ViewBag.Title = "Cloud Border and Dashed Border";
}

<style>
    .toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 12px;
    }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
    }

    .action-group h4 {
        width: 100%;
        margin: 0 0 4px;
        font-size: 13px;
        font-weight: 600;
        color: #424242;
    }

    .action-group button {
        padding: 6px 12px;
        font-size: 13px;
        color: #1b1b1b;
        background: #ffffff;
        border: 1px solid #bdbdbd;
        border-radius: 4px;
        cursor: pointer;
    }

    .action-group button:hover {
        background: #f5f5f5;
        border-color: #1976d2;
    }

    .action-group button:focus-visible {
        outline: 2px solid #1976d2;
        outline-offset: 1px;
    }
</style>

<div>
    <div class="toolbar-actions">
        <div class="action-group">
            <h4>Set annotation mode for newly added annotations</h4>
            <button type="button" onclick="enableRectangleMode()">Rectangle</button>
            <button type="button" onclick="enableCircleMode()">Circle</button>
            <button type="button" onclick="enablePolygonMode()">Polygon</button>
            <button type="button" onclick="enableFreeTextMode()">Free Text</button>
            <button type="button" onclick="enableAreaMode()">Area</button>
            <button type="button" onclick="enableLineMode()">Line</button>
        </div>

        <div class="action-group">
            <h4>Exit annotation mode</h4>
            <button type="button" onclick="exitAnnotationMode()">Exit Annotation Mode</button>
        </div>

        <div class="action-group">
            <h4>Add annotations programmatically</h4>
            <button type="button" onclick="addCloudRectangle()">Cloud Rectangle</button>
            <button type="button" onclick="addDashedCircle()">Dashed Circle</button>
            <button type="button" onclick="addCloudFreeText()">Cloud Free Text</button>
            <button type="button" onclick="addDashedLine()">Dashed Line</button>
            <button type="button" onclick="addCloudArea()">Cloud Area</button>
            <button type="button" onclick="addDashedRadius()">Dashed Radius</button>
        </div>

        <div class="action-group">
            <h4>Modify existing annotation border</h4>
            <button type="button" onclick="applyCloudBorderToSelected()">Apply Cloud Border</button>
            <button type="button" onclick="applyDashedBorderToSelected()">Apply Dashed Border</button>
            <button type="button" onclick="resetBorderOfSelected()">Reset To Solid</button>
        </div>
    </div>

    <div style="height: 650px; width: 100%;">
        @Html.EJS().PdfViewer("pdfviewer").DocumentPath(@Url.Content("~/Content/blank.pdf")).DocumentLoad("documentLoaded").Render()
    </div>
</div>

<script type="text/javascript">
    // Get the PDF Viewer instance
    function getViewer() {
        return document.getElementById('pdfviewer').ej2_instances[0];
    }

    // Apply default border styles once the document has loaded.
    function documentLoaded(arg) {
        var viewer = getViewer();
        if (!viewer) {
            return;
        }
        viewer.rectangleSettings = {
            strokeColor: '#d32f2f',
            fillColor: '#ffe0b2',
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.circleSettings = {
            strokeColor: '#1976d2',
            fillColor: '#bbdefb',
            borderStyle: 'Dashed',
            borderDashArray: [5, 5]
        };
        viewer.freeTextSettings = {
            fillColor: 'red',
            borderColor: '#2e7d32',
            fontColor: '#1b5e20',
            opacity: 0.3,
            enableAutoFit: true,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.cloudSettings = {
            opacity: 1,
            strokeColor: '#9c27b0',
            fillColor: '#f3e5f5',
            author: 'Cloud',
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.lineSettings = {
            strokeColor: '#f57c00',
            borderStyle: 'Dashed',
            borderDashArray: [4, 3]
        };
        viewer.polygonSettings = {
            fillColor: '#ffa5d8',
            strokeColor: '#ff6a00',
            thickness: 2,
            opacity: 0.9,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
        viewer.areaSettings = {
            fillColor: 'yellow',
            strokeColor: 'orange',
            opacity: 0.6,
            borderStyle: 'Cloud',
            cloudIntensity: 2
        };
    }

    // --- Set the mode used for newly added annotations ---

    function enableRectangleMode() {
        getViewer().annotation.setAnnotationMode('Rectangle');
    }

    function enableCircleMode() {
        getViewer().annotation.setAnnotationMode('Circle');
    }

    function enablePolygonMode() {
        getViewer().annotation.setAnnotationMode('Polygon');
    }

    function enableFreeTextMode() {
        getViewer().annotation.setAnnotationMode('FreeText');
    }

    function enableAreaMode() {
        getViewer().annotation.setAnnotationMode('Area');
    }

    function enableLineMode() {
        getViewer().annotation.setAnnotationMode('Line');
    }

    // --- Exit the annotation mode ---

    function exitAnnotationMode() {
        getViewer().annotation.setAnnotationMode('None');
    }

    // --- Add annotations programmatically with cloud/dashed borders ---

    function addCloudRectangle() {
        getViewer().annotation.addAnnotation('Rectangle', {
            offset: { x: 90, y: 120 },
            pageNumber: 1,
            width: 220,
            height: 110,
            borderStyle: 'Cloud',
            cloudIntensity: 2,
            strokeColor: '#d32f2f',
            fillColor: '#ffe0b2',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addDashedCircle() {
        getViewer().annotation.addAnnotation('Circle', {
            offset: { x: 360, y: 120 },
            pageNumber: 1,
            width: 140,
            height: 140,
            borderStyle: 'Dashed',
            borderDashArray: [5, 5],
            strokeColor: '#1976d2',
            fillColor: '#bbdefb',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addCloudFreeText() {
        getViewer().annotation.addAnnotation('FreeText', {
            offset: { x: 90, y: 300 },
            pageNumber: 1,
            width: 220,
            height: 70,
            borderStyle: 'Cloud',
            cloudIntensity: 1,
            borderColor: '#2e7d32',
            fillColor: '#e8f5e9',
            fontColor: '#1b5e20',
            opacity: 0.3,
            author: 'Guest'
        });
    }

    function addDashedLine() {
        getViewer().annotation.addAnnotation('Line', {
            offset: { x: 360, y: 330 },
            pageNumber: 1,
            points: [{ x: 360, y: 330 }, { x: 500, y: 400 }],
            borderStyle: 'Dashed',
            borderDashArray: [4, 3],
            strokeColor: '#f57c00',
            opacity: 1,
            author: 'Guest'
        });
    }

    function addCloudArea() {
        getViewer().annotation.addAnnotation('Area', {
            offset: { x: 90, y: 430 },
            pageNumber: 1,
            vertexPoints: [
                { x: 90, y: 430 },
                { x: 300, y: 430 },
                { x: 300, y: 520 },
                { x: 90, y: 520 }
            ],
            borderStyle: 'Cloud',
            cloudIntensity: 2,
            strokeColor: '#c2185b',
            fillColor: '#fce4ec',
            opacity: 0.4,
            author: 'Guest'
        });
    }

    function addDashedRadius() {
        getViewer().annotation.addAnnotation('Radius', {
            offset: { x: 380, y: 470 },
            pageNumber: 1,
            points: [{ x: 380, y: 470 }, { x: 470, y: 470 }],
            borderStyle: 'Dashed',
            borderDashArray: [6, 3],
            strokeColor: '#00838f',
            opacity: 1,
            author: 'Guest'
        });
    }

    // --- Modify the border style of the most recently added annotation ---
    function updateSelectedBorder(borderStyle, extra) {
        var viewer = getViewer();
        var annotation = viewer.annotationCollection[viewer.annotationCollection.length - 1];

        if (!annotation) {
            return;
        }

        // Set border style
        annotation.borderStyle = borderStyle;

        // Apply additional properties dynamically
        if (extra) {
            Object.keys(extra).forEach(function (key) {
                annotation[key] = extra[key];
            });
        }

        viewer.annotation.editAnnotation(annotation);
    }

    function applyCloudBorderToSelected() {
        updateSelectedBorder('Cloud', {
            cloudIntensity: 2
        });
    }

    function applyDashedBorderToSelected() {
        updateSelectedBorder('Dashed', {
            borderDashArray: [5, 5]
        });
    }

    function resetBorderOfSelected() {
        updateSelectedBorder('Solid', {
            borderDashArray: null,
            cloudIntensity: 1
        });
    }
</script>